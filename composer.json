{
    "name": "alanjancic/craft-sprout",
    "description": "Laravel-style factories and seeders for Craft CMS — generate and tear down realistic demo content from the command line.",
    "type": "craft-plugin",
    "license": "proprietary",
    "keywords": ["seeder", "factory", "faker", "demo content", "fake data", "fixtures", "dev tools"],
    "homepage": "https://github.com/AlanOne/craft-sprout",
    "authors": [
        {
            "name": "Alan Jancic"
        }
    ],
    "support": {
        "issues": "https://github.com/AlanOne/craft-sprout/issues",
        "source": "https://github.com/AlanOne/craft-sprout"
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0.0",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "alanjancic\\sprout\\": "src/"
        }
    },
    "extra": {
        "name": "Sprout",
        "handle": "sprout",
        "developer": "Alan Jancic",
        "class": "alanjancic\\sprout\\Plugin",
        "documentationUrl": "https://github.com/AlanOne/craft-sprout#readme",
        "changelogUrl": "https://raw.githubusercontent.com/AlanOne/craft-sprout/master/CHANGELOG.md"
    }
}
